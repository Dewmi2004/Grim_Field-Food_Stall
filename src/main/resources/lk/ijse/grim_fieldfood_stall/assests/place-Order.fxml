<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="798.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom, #0a0a0a, #1a1a1a);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.grim_fieldfood_stall.controller.OrderPageController">

    <children>
        <VBox alignment="TOP_CENTER" layoutX="11.2" layoutY="11.2" prefHeight="651.0" prefWidth="879.0" spacing="10.0" style="-fx-background-color: rgba(120, 104, 106, 0.8); -fx-background-radius: 25 25 60 60; -fx-border-color: darkred; -fx-border-width: 5; -fx-padding: 20; -fx-effect: dropshadow(gaussian, black, 15, 0.7, 3, 3);" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="11.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="11.0">

            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>

            <!-- Title -->
            <Label style="-fx-font-size: 50px; -fx-text-fill: crimson; -fx-font-family: 'Chiller'; -fx-effect: dropshadow(gaussian, black, 10, 0.8, 3, 3);" text="☠ Coffin Feast - Place Your Order ☠" />

            <!-- Order Info -->
            <VBox spacing="8.0">
                <HBox spacing="10.0">
                    <Label prefHeight="20.0" prefWidth="75.0" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Order ID" />
                    <Label fx:id="lblOrderId" prefHeight="20.0" prefWidth="165.0" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Auto-genarated" />
                </HBox>
                <HBox spacing="10.0">
                    <Label prefHeight="20.0" prefWidth="80.0" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Order Date" />
                    <TextField fx:id="txtDate" editable="false" style="-fx-background-color: #2b2b2b; -fx-text-fill: #f5f5f5; -fx-border-color: crimson; -fx-border-width: 1.5; -fx-padding: 5 10 5 10; -fx-background-radius: 5;" />
                </HBox>
            </VBox>

            <!-- Item Selection -->
            <HBox spacing="10.0">
                <Label prefHeight="20.0" prefWidth="79.0" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Item Name" />
                <ComboBox fx:id="cmbItemId" prefHeight="27.0" prefWidth="153.0" style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-border-color: crimson; -fx-border-radius: 5;" />
                <Label fx:id="lblItemId" prefHeight="20.0" prefWidth="98.0" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Item ID" />
                <Label fx:id="lblAvailableQuantity" prefHeight="20.0" prefWidth="155.0" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Available Quantity" />
            </HBox>

            <!-- Quantity Input -->
            <HBox spacing="10.0">
                <Label prefHeight="20.0" prefWidth="80.0" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Quantity" />
                <TextField fx:id="txtQuantity" style="-fx-background-color: #2b2b2b; -fx-text-fill: #f5f5f5; -fx-border-color: crimson; -fx-border-width: 1.5; -fx-padding: 5 10 5 10; -fx-background-radius: 5;" />
            </HBox>

            <!-- Add to Cart Button -->
            <Button fx:id="btnAddToCart" onAction="#btnAddtoCartOnAction" style="-fx-background-color: darkred; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, black, 8, 0.7, 2, 2);" text="➕ Add to Cart" />

            <!-- Cart Table -->
            <TableView fx:id="tblCart" prefHeight="200.0" prefWidth="834.0" style="-fx-background-color: rgba(120, 104, 106, 0.8); -fx-border-width: 2; -fx-selection-bar: darkred; -fx-selection-bar-non-focused: crimson; -fx-background-radius: 20;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colItemId" text="Item ID" />
                    <TableColumn fx:id="colName" text="Name" />
                    <TableColumn fx:id="colQty" text="Quantity" />
                    <TableColumn fx:id="colUnitPrice" text="Unit Price" />
                    <TableColumn fx:id="colTotal" text="Total" />
                    <TableColumn fx:id="colRemove" text="Action" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- Payment Section -->
            <VBox prefHeight="198.0" prefWidth="834.0" spacing="8.0" style="-fx-background-color: rgba(120, 104, 106, 0.8); -fx-background-radius: 25 25 60 60; -fx-border-width: 2; -fx-padding: 20; -fx-effect: dropshadow(gaussian, black, 15, 0.7, 3, 3);" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-size: 25px; -fx-text-fill: ghostwhite; -fx-font-family: &quot;Kablammo&quot;; -fx-effect: dropshadow(gaussian, black, 5, 0.8, 2, 2);" text="💀 Payment Info" />

                <HBox spacing="10.0">
                    <Label style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Payment ID" />
                    <Label fx:id="lblPaymentId" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Auto-gen" />
                </HBox>

                <HBox spacing="10.0">
                    <Label prefHeight="20.0" prefWidth="89.0" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Method:" />
                    <ComboBox fx:id="cmbMethod" prefHeight="27.0" prefWidth="158.0" style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-border-color: crimson; -fx-border-radius: 5;" />
                </HBox>

                <HBox spacing="10.0">
                    <Label style="-fx-text-fill: ghostwhite; -fx-font-size: 18px; -fx-font-weight: bold;" text="Total:" />
                    <Label fx:id="lblTotalAmount" style="-fx-text-fill: ghostwhite; -fx-font-size: 18px; -fx-font-weight: bold;" text="0.00" />
                </HBox>

                   <HBox spacing="10.0">
                    <Label style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Paid Amount:" />
                    <TextField fx:id="txtPaidAmount" style="-fx-background-color: #2b2b2b; -fx-text-fill: #f5f5f5; -fx-border-color: crimson; -fx-border-width: 1.5; -fx-padding: 5 10 5 10; -fx-background-radius: 5;" />
                    <Button fx:id="btnCheckBalance" onAction="#btnCheckBalanceOnAction" prefHeight="38.0" prefWidth="89.0" style="-fx-background-color: darkred; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, black, 8, 0.7, 2, 2);" text="Check" />
                    <Label style="-fx-text-fill: limegreen; -fx-font-size: 18px; -fx-font-weight: bold;" text="Change:" />
                    <Label fx:id="lblChange" style="-fx-text-fill: limegreen; -fx-font-size: 18px; -fx-font-weight: bold;" text="0.00" />
                </HBox>
            </VBox>

            <!-- Place Order Button -->
            <Button fx:id="btnPlaceOrder" onAction="#btnPlaceOrderOnAction" prefHeight="44.0" prefWidth="286.0" style="-fx-background-color: darkred; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20px; -fx-padding: 12 40 12 40; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, black, 12, 0.8, 3, 3);" text="☠_Place Order☠" />
        </VBox>
    </children>
</AnchorPane>
