<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="888.0" prefWidth="1072.0" style="-fx-background-color:linear-gradient(to bottom, #000000, #D2691E);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.grim_fieldfood_stall.controller.OrderPageController">

    <children>
        <VBox fx:id="rootVBox" alignment="TOP_CENTER" onKeyPressed="#btnPlaceOrderOnAction" prefHeight="871.0" prefWidth="1054.0" spacing="10.0" style="-fx-background-color:linear-gradient(to bottom,#000000, #D2691E, #D2691E); -fx-background-radius: 25 25 60 60; -fx-border-color: #D2691E; -fx-border-width: 5; -fx-padding: 20; -fx-effect: dropshadow(gaussian, #000000, 15, 0.7, 3, 3);" AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="11.0" AnchorPane.rightAnchor="7.0" AnchorPane.topAnchor="9.0">

            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>

            <!-- 🎃 Title -->
            <Label opacity="0.8" style="-fx-font-size: 70px; -fx-text-fill: #ff4500; -fx-font-family: 'Chiller'; -fx-effect: dropshadow(gaussian, #ffffff, 8, 0.5, 3, 3);" text="🎃 Grim Theater - Food Items 👻" />

            <!-- 🧾 Order Info -->
            <VBox spacing="8.0">
                <HBox spacing="10.0">
                    <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;" text="Order ID" visible="false" />
                    <Label fx:id="lblOrderId" style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;" text="Auto-generated" visible="false" />
                    <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold;" text="Order Date" />
                    <TextField fx:id="txtDate" editable="false" prefWidth="307.0" style="-fx-background-color: #000000; -fx-text-fill: #FFFFFF; -fx-border-color: #ff4500; -fx-border-width: 2.5; -fx-padding: 5 10 5 10; -fx-background-radius: 5;" />
                </HBox>
            </VBox>

            <!-- 🍔 Item Selection -->
            <HBox alignment="CENTER" prefHeight="296.0" prefWidth="1004.0" spacing="40">

                <!-- 🥯 chips -->
                <VBox alignment="CENTER" spacing="5">
                    <ImageView fx:id="imgChips" fitHeight="150" fitWidth="150">
                        <image>
                            <Image url="@../images/chips.jpg" />
                        </image>
                    </ImageView>
                    <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Chips" />
                    <Label fx:id="lblPriceChips" style="-fx-text-fill: #ffae42; -fx-font-size: 18px;" text="100.00" />
                    <HBox alignment="CENTER" spacing="10">
                        <Button onAction="#btnMinusChipsOnAction" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold;" text="-" />
                        <Label fx:id="lblQtyChips" style="-fx-text-fill: white; -fx-font-size: 18px;" text="0" />
                        <Button onAction="#btnPlusChipsOnAction" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold;" text="+" />
                    </HBox>
                    <Button onAction="#btnAddChipsOnAction" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold;" text="Add to Cart" />
                </VBox>

                <!-- 🧃 Drink -->
                <VBox alignment="CENTER" spacing="5">
                    <ImageView fx:id="imgDrink" fitHeight="150" fitWidth="150">
                        <image>
                            <Image url="@../images/drink1.jpg" />
                        </image>
                    </ImageView>
                    <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Drink" />
                    <Label fx:id="lblPriceDrink" style="-fx-text-fill: #ffae42; -fx-font-size: 18px;" text="150.00" />
                    <HBox alignment="CENTER" spacing="10">
                        <Button onAction="#btnMinusDrinkOnAction" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold;" text="-" />
                        <Label fx:id="lblQtyDrink" style="-fx-text-fill: white; -fx-font-size: 18px;" text="0" />
                        <Button onAction="#btnPlusDrinkOnAction" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold;" text="+" />
                    </HBox>
                    <Button onAction="#btnAddDrinkOnAction" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold;" text="Add to Cart" />
                </VBox>

                <!-- 🌽 Corn -->
                <VBox alignment="CENTER" spacing="5">
                    <ImageView fx:id="imgCorn" fitHeight="150" fitWidth="150">
                        <image>
                            <Image url="@../images/pop.jpg" />
                        </image>
                    </ImageView>
                    <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Corn" />
                    <Label fx:id="lblPriceCorn" style="-fx-text-fill: #ffae42; -fx-font-size: 18px;" text="120.00" />
                    <HBox alignment="CENTER" spacing="10">
                        <Button onAction="#btnMinusCornOnAction" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold;" text="-" />
                        <Label fx:id="lblQtyCorn" style="-fx-text-fill: white; -fx-font-size: 18px;" text="0" />
                        <Button onAction="#btnPlusCornOnAction" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold;" text="+" />
                    </HBox>
                    <Button onAction="#btnAddCornOnAction" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold;" text="Add to Cart" />
                </VBox>
                <!--   All-->
                <VBox alignment="CENTER" spacing="5">
                    <ImageView fx:id="imgAll" fitHeight="150" fitWidth="150">
                        <image>
                            <Image url="@../images/all food.jpg" />
                        </image>
                    </ImageView>
                    <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Package" />
                    <Label fx:id="lblPriceAll" style="-fx-text-fill: #ffae42; -fx-font-size: 18px;" text="100.00" />
                    <HBox alignment="CENTER" spacing="10">
                        <Button onAction="#btnMinusAllOnAction" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold;" text="-" />
                        <Label fx:id="lblQtyAll" style="-fx-text-fill: white; -fx-font-size: 18px;" text="0" />
                        <Button onAction="#btnPlusAllOnAction" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold;" text="+" />
                    </HBox>
                    <Button onAction="#btnAddAllOnAction" style="-fx-background-color: #ff4500; -fx-text-fill: white; -fx-font-weight: bold;" text="Add to Cart" />
                </VBox>
            </HBox>

            <!-- 🛒 Cart Table -->
            <TableView fx:id="tblCart" prefHeight="400.0" prefWidth="934.0" style="-fx-background-color: #D2691E; -fx-border-width: 3; -fx-selection-bar: #D2691E; -fx-background-radius: 20; -fx-border-color: #ff4500;">
                <columns>
                    <TableColumn fx:id="colItemId" text="Item ID" />
                    <TableColumn fx:id="colName" text="Name" />
                    <TableColumn fx:id="colQty" text="Quantity" />
                    <TableColumn fx:id="colUnitPrice" text="Unit Price" />
                    <TableColumn fx:id="colTotal" text="Total" />
                    <TableColumn fx:id="colRemove" text="Action" />
                </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            </TableView>

            <!-- 💵 Payment Section -->
            <VBox spacing="10.0" style="-fx-background-color:linear-gradient(to bottom, #3C3C3C, #D2691E); -fx-background-radius: 25 25 60 60; -fx-border-width: 2; -fx-padding: 20; -fx-effect: dropshadow(gaussian, #000000, 15, 0.7, 3, 3);">

                <Label style="-fx-font-size: 30px; -fx-text-fill: #FFFFFF; -fx-font-family: 'Kablammo'; -fx-effect: dropshadow(gaussian, #000000, 5, 0.8, 2, 2);" text="💀 Payment Info" />

                <HBox spacing="10.0">
                    <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 25px; -fx-font-weight: bold;" text="Total:" />
                    <Label fx:id="lblTotalAmount" style="-fx-text-fill: #FFFFFF; -fx-font-size: 25px; -fx-font-weight: bold;" text="0.00" />
                </HBox>

                <HBox spacing="10.0">
                    <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 22px; -fx-font-weight: bold;" text="Paid Amount:" />
                    <TextField fx:id="txtPaidAmount" prefHeight="39.0" prefWidth="260.0" style="-fx-background-color: #000000; -fx-text-fill: #FFFFFF; -fx-border-color: #ff4500; -fx-border-width: 1.5; -fx-padding: 5 10 5 10; -fx-background-radius: 5;" />
                    <Button fx:id="btnCheckBalance" onAction="#btnCheckBalanceOnAction" prefHeight="38.0" prefWidth="151.0" style="-fx-background-color: #ff4500; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;" text="Check" />
                    <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 22px; -fx-font-weight: bold;" text="Change:" />
                    <Label fx:id="lblChange" style="-fx-text-fill: #FFFFFF; -fx-font-size: 22px; -fx-font-weight: bold;" text="0.00" />
                </HBox>
            </VBox>

            <!-- 🔘 Buttons -->
            <HBox alignment="CENTER" opacity="0.85" spacing="15.0">
                <Button fx:id="btnBack" onAction="#btnBackOnAction" prefHeight="58.0" prefWidth="150.0" style="-fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #000000, 8, 0.7, 2, 2);">
                    <graphic>
                        <Label style="-fx-font-size: 25px; -fx-text-fill: #ff4500;" text="Go Back" />
                    </graphic>
                </Button>

                <Button fx:id="btnPlaceOrder" onAction="#btnPlaceOrderOnAction" prefHeight="44.0" prefWidth="286.0" style="-fx-background-color: #ff4500; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 25px; -fx-padding: 12 40 12 40; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, #000000, 12, 0.8, 3, 3);" text="🎃 Place Order 👻" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
