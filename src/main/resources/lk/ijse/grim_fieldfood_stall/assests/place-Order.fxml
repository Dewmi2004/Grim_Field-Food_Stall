<AnchorPane prefHeight="888.0" prefWidth="1072.0" style="-fx-background-color:linear-gradient(to bottom, #000000, #D2691E);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.grim_fieldfood_stall.controller.OrderPageController">

    <children>
        <VBox alignment="TOP_CENTER" layoutX="11.2" layoutY="8.8" prefHeight="871.0" prefWidth="1054.0" spacing="10.0" style="-fx-background-color:linear-gradient(to bottom,#000000, #D2691E, #D2691E); -fx-background-radius: 25 25 60 60; -fx-border-color: #D2691E; -fx-border-width: 5; -fx-padding: 20; -fx-effect: dropshadow(gaussian, #000000, 15, 0.7, 3, 3);" AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="11.0" AnchorPane.rightAnchor="7.0" AnchorPane.topAnchor="9.0">

