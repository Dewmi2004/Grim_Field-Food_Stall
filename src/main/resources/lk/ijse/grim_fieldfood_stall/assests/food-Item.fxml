<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="750.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom, #0a0a0a, #1a1a1a);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.grim_fieldfood_stall.controller.FoodPageController">

    <children>
        <VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="860.0" spacing="15.0" style="-fx-background-color: rgba(120, 104, 106, 0.8);                      -fx-background-radius: 25 25 60 60;                      -fx-border-color: darkred;                      -fx-border-width: 5;                      -fx-padding: 20;                      -fx-effect: dropshadow(gaussian, black, 15, 0.7, 3, 3);" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="15.0">

            <!-- Title -->
            <Label style="-fx-font-size: 50px; -fx-text-fill: crimson; -fx-font-family: 'Chiller'; -fx-effect: dropshadow(gaussian, black, 10, 0.8, 3, 3);" text="☠ Coffin Feast - Food Items ☠" />

            <!-- Input Fields in Grid -->
            <GridPane hgap="15.0" vgap="12.0">
                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints halignment="RIGHT" minWidth="120.0" />
                    <javafx.scene.layout.ColumnConstraints halignment="LEFT" minWidth="250.0" />
                </columnConstraints>

                <children>
                    <Label prefHeight="20.0" prefWidth="155.0" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Food ID" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtFoodId" style="-fx-background-color: #2b2b2b; -fx-text-fill: #f5f5f5;                                       -fx-border-color: crimson; -fx-border-width: 1.5;                                       -fx-padding: 5 10 5 10; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label prefHeight="20.0" prefWidth="154.0" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Name" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="txtName" style="-fx-background-color: #2b2b2b; -fx-text-fill: #f5f5f5;                                       -fx-border-color: crimson; -fx-border-width: 1.5;                                       -fx-padding: 5 10 5 10; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label prefHeight="20.0" prefWidth="154.0" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Quantity" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField fx:id="txtQuantity" style="-fx-background-color: #2b2b2b; -fx-text-fill: #f5f5f5;                                       -fx-border-color: crimson; -fx-border-width: 1.5;                                       -fx-padding: 5 10 5 10; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label prefHeight="20.0" prefWidth="154.0" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Unit Selling Price" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="txtUnitPrice" style="-fx-background-color: #2b2b2b; -fx-text-fill: #f5f5f5;                                       -fx-border-color: crimson; -fx-border-width: 1.5;                                       -fx-padding: 5 10 5 10; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label prefHeight="20.0" prefWidth="154.0" style="-fx-text-fill: ghostwhite; -fx-font-size: 14px; -fx-font-weight: bold;" text="Total Buying Price" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <TextField fx:id="txtTotalPrice" style="-fx-background-color: #2b2b2b; -fx-text-fill: #f5f5f5;                                       -fx-border-color: crimson; -fx-border-width: 1.5;                                       -fx-padding: 5 10 5 10; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                </children>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" prefHeight="35.0" prefWidth="810.0" spacing="15.0">
                <Button fx:id="btnSaveFood" onAction="#btnSaveFoodOnAction" prefHeight="49.0" prefWidth="155.0" style="-fx-background-color: darkred; -fx-font-weight: bold;                    -fx-padding: 10 25; -fx-background-radius: 8;                    -fx-effect: dropshadow(gaussian, black, 8, 0.7, 2, 2);">
                    <graphic>
                        <HBox alignment="CENTER" spacing="6">
                            <Label style="-fx-font-size: 19px; -fx-text-fill: white;" text="💾" />
                            <Label style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-family: 'Chiller';" text="Save" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnUpdateFood" onAction="#btnUpdateFoodOnAction" prefHeight="49.0" prefWidth="162.0" style="-fx-background-color: #8B0000; -fx-font-weight: bold;                    -fx-padding: 10 25; -fx-background-radius: 8;                    -fx-effect: dropshadow(gaussian, black, 8, 0.7, 2, 2);">
                    <graphic>
                        <HBox alignment="CENTER" spacing="6">
                            <Label style="-fx-font-size: 19px; -fx-text-fill: white;" text="✏" />
                            <Label prefHeight="20.0" prefWidth="78.0" style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-family: 'Chiller';" text="Update" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnDeleteFood" onAction="#btnDeleteFoodOnAction" prefHeight="49.0" prefWidth="174.0" style="-fx-background-color: #8B0000; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, black, 8, 0.7, 2, 2);">
                    <graphic>
                        <HBox alignment="CENTER" spacing="6">
                            <Label style="-fx-font-size: 19px; -fx-text-fill: white;" text="🗑" />
                            <Label style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-family: 'Chiller';" text="Delete" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnClearFood" onAction="#btnClearFoodOnAction" prefHeight="27.0" prefWidth="146.0" style="-fx-background-color: #8B0000; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, black, 8, 0.7, 2, 2);">
                    <graphic>
                        <HBox alignment="CENTER" spacing="6">
                            <Label style="-fx-font-size: 19px; -fx-text-fill: white;" text="♻" />
                            <Label prefHeight="28.0" prefWidth="40.0" style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-family: 'Chiller';" text="Clear" />
                        </HBox>
                    </graphic>
                </Button>
            </HBox>



            <!-- Food Table -->
            <TableView fx:id="tblFood" prefHeight="300.0" prefWidth="820.0" style="-fx-background-color: rgba(120, 104, 106, 0.8);                               -fx-border-width: 2;                               -fx-selection-bar: darkred;                               -fx-selection-bar-non-focused: crimson;                               -fx-background-radius: 20;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFoodId" text="Food ID" />
                    <TableColumn fx:id="colName" text="Name" />
                    <TableColumn fx:id="colQty" text="Quantity" />
                    <TableColumn fx:id="colUnitPrice" text="Unit Price" />
                    <TableColumn fx:id="colTotalPrice" text="Total Buying Price" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
